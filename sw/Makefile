# target tool-chain selection
# name consists of architecture vendor operating system and binary format
ARCH=riscv64-unknown-elf
#ARCH=riscv64-linux-gnu

# when C code with main is used, enable next line
#SOURCES += crt0local.S
# the list of C or assembler source files
SOURCES += gcd.S

# the name of the target executable file
TARGET_EXE = gcd

# specify compiler and utilities binaries
CC=$(ARCH)-gcc
CXX=$(ARCH)-g++
AS=$(ARCH)-as
LD=$(ARCH)-ld
OBJCOPY=$(ARCH)-objcopy

# specify ABI for parameters passing, architecture, its variant etc.
ARCHFLAGS += -mabi=ilp32
ARCHFLAGS += -march=rv32i
ARCHFLAGS += -fno-lto

# debugging, optimize for size, warnings etc.
CFLAGS  += -ggdb -Os -Wall
CXXFLAGS+= -ggdb -Os -Wall
AFLAGS  += -ggdb

# linker flags, debugging, no implicit libraries and start files
LDFLAGS += -ggdb
LDFLAGS += -nostartfiles
LDFLAGS += -nostdlib
LDFLAGS += -static

# linker script to map text section and start from address 0x00000200
# on the address 0x00000000 is value pointing to the end of memory
# and on the address 0x00000004 is pointer to start of program
# this information is used in VHDL version of RVAPO implementation
LDFLAGS += -Triscv32-bare.ld

#LDFLAGS += -specs=/opt/musl/riscv64-linux-gnu/lib/musl-gcc.specs

LOADLIBES += -lgcc

CFLAGS  += $(ARCHFLAGS)
CXXFLAGS+= $(ARCHFLAGS)
AFLAGS  += $(ARCHFLAGS)
LDFLAGS += $(ARCHFLAGS)

# generate list of object files from the specified sources
OBJECTS += $(filter %.o,$(SOURCES:%.S=%.o))
OBJECTS += $(filter %.o,$(SOURCES:%.c=%.o))
OBJECTS += $(filter %.o,$(SOURCES:%.cpp=%.o))

# the first target is the default one when make invoked without argument
all : default

# targets which are only wishes and do not generate corresponding files
.PHONY : default clean dep all run


# generic rules how to compile one file type to another

%.o:%.S
	$(CC) -D__ASSEMBLY__ $(AFLAGS) -c $< -o $@

%.o:%.c
	$(CC) $(CFLAGS) $(CPPFLAGS) -c $< -o $@

%.o:%.cpp
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -c $<

%.s:%.c
	$(CC) $(CFLAGS) $(CPPFLAGS) -S $< -o $@

%.srec:%
	$(OBJCOPY) -O srec $< $@

%.dat:%.bin
	hexdump -v -e '"%08x\n" ' $< >$@

%.decb:%.bin
	hexdump -v -e '1/1 "%u\n" ' $< >$@

# --only-section=.text
%.bin:%
	$(OBJCOPY) --strip-debug -O binary $< $@

%.out:%
	$(OBJCOPY) -O ecoff-bigmips $< $@


# compute dependencies of object files on all sources used/included

dep: depend

depend: $(SOURCES) $(glob *.h)
	echo '# autogenerated dependencies' > depend
ifneq ($(filter %.S,$(SOURCES)),)
	$(CC)  -D__ASSEMBLY__ $(AFLAGS) -w -E -M $(filter %.S,$(SOURCES)) \
	  >> depend
endif
ifneq ($(filter %.c,$(SOURCES)),)
	$(CC) $(CFLAGS) $(CPPFLAGS) -w -E -M $(filter %.c,$(SOURCES)) \
	  >> depend
endif
ifneq ($(filter %.cpp,$(SOURCES)),)
	$(CXX) $(CXXFLAGS) $(CPPFLAGS) -w -E -M $(filter %.cpp,$(SOURCES)) \
	  >> depend
endif

# specify default target dependencies
# specifies what is build when make invoked without target specified

#default : $(TARGET_EXE)
default : $(TARGET_EXE).srec $(TARGET_EXE).dat $(TARGET_EXE).decb

# specification for executable build

$(TARGET_EXE) : $(OBJECTS)
	$(CC) $(LDFLAGS) $^ $(LOADLIBES) -o $@

# target to clean all compilation products

clean:
	rm -f *.o *.a $(OBJECTS) $(TARGET_EXE) depend \
		$(TARGET_EXE).out $(TARGET_EXE).srec \
		$(TARGET_EXE).dat $(TARGET_EXE).decb

# run code in QtRvSim command-line version

run: $(TARGET_EXE)
	qtrvsim_cli --pipelined \
		--dump-cycles --dump-registers \
		$<

-include depend
